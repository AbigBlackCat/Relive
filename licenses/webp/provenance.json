{
  "name": "libwebp",
  "version": "1.6.0",
  "license": "BSD-3-Clause",
  "homepage": "https://developers.google.com/speed/webp/",
  "repository": "https://chromium.googlesource.com/webm/libwebp",
  "source": {
    "url": "https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz",
    "sha256": "e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564"
  },
  "bundled_tools": [
    "img2webp",
    "webpinfo"
  ],
  "macos": {
    "minimum_version": "13.0",
    "linkage": "static",
    "configure_flags": [
      "--disable-shared",
      "--enable-static",
      "--disable-sdl",
      "--disable-png",
      "--disable-jpeg",
      "--disable-tiff",
      "--disable-gl",
      "--disable-threading"
    ]
  },
  "windows": {
    "architecture": "x86_64",
    "generator": "Visual Studio 17 2022",
    "cmake_flags": [
      "-DBUILD_SHARED_LIBS=OFF",
      "-DWEBP_LINK_STATIC=ON",
      "-DWEBP_UNICODE=OFF",
      "-DCMAKE_POLICY_DEFAULT_CMP0091=NEW",
      "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded",
      "-DWEBP_USE_THREAD=OFF",
      "-DWEBP_BUILD_IMG2WEBP=ON",
      "-DWEBP_BUILD_WEBPINFO=ON",
      "-DWEBP_BUILD_LIBWEBPMUX=ON",
      "-DWEBP_BUILD_ANIM_UTILS=OFF",
      "-DWEBP_BUILD_CWEBP=OFF",
      "-DWEBP_BUILD_DWEBP=OFF",
      "-DWEBP_BUILD_GIF2WEBP=OFF",
      "-DWEBP_BUILD_VWEBP=OFF",
      "-DWEBP_BUILD_WEBPMUX=OFF",
      "-DWEBP_BUILD_EXTRAS=OFF",
      "-DCMAKE_DISABLE_FIND_PACKAGE_PNG=ON",
      "-DCMAKE_DISABLE_FIND_PACKAGE_JPEG=ON",
      "-DCMAKE_DISABLE_FIND_PACKAGE_TIFF=ON",
      "-DCMAKE_DISABLE_FIND_PACKAGE_GIF=ON"
    ],
    "runtime": "static MSVC CRT",
    "unicode": false,
    "source_build": true
  },
  "source_patch": {
    "file": "argument-capacity.patch",
    "sha256": "e891bd9c764542ba9bbb7cf5029c23f7fb6f8d557e0f4c807b986ad21a8b82a0",
    "reason": "Raise heap argument capacity to 1048576; no codec algorithm changes.",
    "original_file_sha256": "d52fae3e10b4e7dc40adcf75b6ad4618faae4b29847639b568c2dcf38be4a5f8",
    "patched_file_sha256": "cb419c1ead62bffd4c247f597538ba7d564100a47320d2f76ddeeeac7f055d51"
  }
}
