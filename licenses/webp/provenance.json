{
  "name": "libwebp",
  "version": "1.6.0",
  "license": "BSD-3-Clause",
  "homepage": "https://developers.google.com/speed/webp/",
  "repository": "https://chromium.googlesource.com/webm/libwebp",
  "source": {
    "url": "https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz",
    "sha256": "e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564"
  },
  "windows_archive": {
    "url": "https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0-windows-x64.zip",
    "sha256": "48886f506b21f62e4661f0f4cbfca19800897c385128e8902542d29a950c93f1"
  },
  "bundled_tools": [
    "img2webp",
    "webpinfo"
  ],
  "macos": {
    "minimum_version": "13.0",
    "linkage": "static",
    "configure_flags": [
      "--disable-shared",
      "--enable-static",
      "--disable-sdl",
      "--disable-png",
      "--disable-jpeg",
      "--disable-tiff",
      "--disable-gl",
      "--disable-threading"
    ]
  }
