{
  "name": "relive",
  "productName": "Relive",
  "version": "1.1.0",
  "description": "Offline Live Photo editor for macOS and Windows",
  "private": true,
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:portable": "node --test desktop/test/*.test.cjs",
    "test:desktop": "electron . --smoke-test",
    "prepare:windows": "python3 desktop/scripts/prepare_windows_ffmpeg.py",
    "build:windows": "electron-builder --win nsis zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.relive.windows",
    "productName": "Relive",
    "directories": {
      "output": "dist/windows",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/core/**",
      "desktop/renderer/**",
      "desktop/smoke.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/vendor/win32-x64",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "Resources/使用说明.html",
        "to": "使用说明.html"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false,
      "artifactName": "Relive-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Relive-${version}-Windows-x64-Setup.${ext}"
    }
  }
}
